# Copia como .env (scripts/init-env.sh lo hace por ti). NUNCA subas .env a git.
# Los secretos (SECRET_KEY y contraseña de BD) van en ./secrets/, no aquí.

COMPOSE_PROJECT_NAME=nexsurcode-dev

# --- Django ---
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dev.nexsurcode.com
DJANGO_LOG_LEVEL=INFO
# HSTS: 1 año. En dev NO incluir subdominios ni preload.
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Desarrollo: estáticos servidos directo desde las apps.
WHITENOISE_USE_FINDERS=true
TZ=America/Santiago

# --- Correo (Gmail) ---
# Mientras no configures Gmail, los correos se muestran en los logs de 'web'.
# Para Gmail: cambia a django.core.mail.backends.smtp.EmailBackend, completa
# DJANGO_EMAIL_USER y guarda la contraseña de aplicación en secrets/email_password.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_USER=
DJANGO_DEFAULT_FROM_EMAIL=
OTP_TOTP_ISSUER=ERP Silvoagropecuario (dev)

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_RELOAD=true

# --- PostgreSQL ---
POSTGRES_DB=nexsurcode
# Rol de la aplicación (sin superusuario). El superusuario es 'postgres'.
DB_USER=nexsurcode
